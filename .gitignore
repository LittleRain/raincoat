# all skill local input artifacts
skills/**/input/

# generated local report artifact
skills/raincoat-gongfang-weekly-report/output/report.html

# local agent state and runtimes
.workbuddy/
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
# generated skill artifacts; curated examples/assets remain versionable
skills/**/output/
skills/**/report.html
# example configuration must remain distributable
!.env.example
!**/.env.example

# migration inventories and local-only agent permissions
.migration/
.claude/settings.local.json
# browser capture profiles must never enter release artifacts
**/chrome-profile/
**/wecom-playwright-profile/

# private weekly-report inputs retained locally after verified archive
skills/raincoat-report-circle-weekly/docs/*.xlsx

# generated Skill execution logs
skills/**/run.log

# agent / codex 临时 home（含登录态，勿入库）
.tmp/

# skill-panel 的产物不落在 skill 目录里（默认 ~/.skill-panel/，可用 --out 改），
# 它自己的 .gitignore 是兜底，导出成独立仓库时跟着一起走。
