# Paths may be absolute. Defaults are application-local and independent of cwd.
# FAS_DATA_DIR=/absolute/path/to/data
# FAS_MEDIA_ROOT=/absolute/path/to/approved/videos
FAS_PORT=8765
FAS_MAX_UPLOAD_BYTES=107374182400
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/bin/ffprobe
# FAS_FONT_PATH=/System/Library/Fonts/STHeiti Light.ttc

# Remote analysis stays off until explicitly enabled and started in the UI.
FAS_AI_ENABLED=false
# Workbench chooses MiniMax first for full scans; Gemini can be selected manually.
# No automatic cross-provider retry. Each 12s window reserves two calls.
FAS_AI_PROVIDER=minimax
# MiniMax profile; source-timestamped frames are the default.
MINIMAX_API_KEY=configure-locally-only
# FAS_MINIMAX_INPUT_MODE=frames
# Native video mode had unstable source timestamps in the local sample; use only for experiments.
# FAS_MINIMAX_INPUT_MODE=video
# FAS_MINIMAX_BASE_URL=https://api.minimax.io/v1
# FAS_MINIMAX_MODEL=MiniMax-M3
# Gemini profile; these values also remain the legacy default provider config.
# FAS_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# FAS_AI_MODEL=gemini-3.8-flash
# FAS_AI_API_KEY=configure-locally-only
