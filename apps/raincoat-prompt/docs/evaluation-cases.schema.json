{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-cases.schema.json",
  "title": "Raincoat Prompt evaluation case bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "common_instruction", "cases", "pilot", "extended_pilot", "scoring"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "common_instruction": {"type": "string", "minLength": 1},
    "cases": {"type": "array", "minItems": 40, "items": {"$ref": "#/$defs/case"}},
    "pilot": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}},
    "extended_pilot": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}},
    "scoring": {
      "type": "object", "additionalProperties": false,
      "required": ["core_checks", "bonus_checks", "decision_order"],
      "properties": {
        "core_checks": {"const": 3}, "bonus_checks": {"const": 1},
        "decision_order": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "scene", "subscene", "input", "original", "optimized", "materials", "checks", "core_checks", "bonus_check", "critical_errors", "split"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "scene": {"enum": ["调研", "数据分析", "开发", "写方案", "写报告"]},
        "subscene": {"type": "string", "minLength": 1},
        "input": {"type": "string", "minLength": 1},
        "original": {"type": "string", "minLength": 1},
        "optimized": {"type": "string", "minLength": 1},
        "materials": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "checks": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "minLength": 1}},
        "core_checks": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1}},
        "bonus_check": {"type": "string", "minLength": 1},
        "critical_errors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "split": {"enum": ["pilot", "development", "holdout"]}
      }
    }
  }
}
